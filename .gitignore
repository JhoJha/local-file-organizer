# Generated catalog/report output can contain real personal file paths and
# must never be committed.
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
!data/.gitkeep

reports/*.csv
!reports/.gitkeep

data/snapshots/
data/debug_frames/

__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.ruff_cache/
